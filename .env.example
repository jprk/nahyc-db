# doc/PLAN.md §18/§19/§20, 2026-09-17. Copy to .env (repo-root,
# gitignored) and fill in real values — app/app.py and every src/tools/
# script read it via python-dotenv, connecting with EXACTLY this account.
#
# This account must NEVER need a global CREATE DATABASE privilege —
# rights scoped to the h2regdocs database alone are enough (verified
# against this project's own deployment: that's exactly what its real
# runtime account has). src/tools/provision_db.py is what CREATEs this
# database and this user in the first place, using a SEPARATE, more
# privileged admin account — never read from this file. See that
# script's own --help / module docstring for how to supply admin
# credentials (an interactive prompt by default, so a real admin
# password is never something you're asked to put in a file).

DB_HOST=localhost
DB_PORT=3306
DB_NAME=h2regdocs
DB_USER=h2regdocs
DB_PASSWORD=

# doc/PLAN.md §42, 2026-09-18: signs the editor-login session cookie
# (app/admin.py's Flask blueprint) — flask.session is unusable without
# it. Generate a real value with, e.g., `python3 -c "import secrets;
# print(secrets.token_hex(32))"`; never reuse this example value.
SECRET_KEY=

# Separate from .env: src/tools/enrich_annotations.py,
# translate_annotations.py and synthesize_summaries.py (doc/PLAN.md §17)
# need an OpenAI API key in a repo-root file named exactly ".openapi_key"
# (plain text, key only, no quotes — also gitignored). Not needed to run
# the app itself, only those three enrichment scripts.
