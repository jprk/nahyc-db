# Kopie produkce pro testovací web nahyc.fd.cvut.cz/h2db (doc/NASAZENI.md, odstavec 6).
# Instalace na produkci: cesty a uživatele upravit podle odstavce 3, pak
#   sudo cp deploy/production/h2db-copy-to-test.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now h2db-copy-to-test.timer
[Unit]
Description=NAHYC H2DB: kopie produkce na testovací web
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=oneshot
User=h2db
Group=h2db
WorkingDirectory=/srv/h2db/repo
ExecStart=/srv/h2db/repo/deploy/production/push_copy_to_test.sh
TimeoutStartSec=1h
Nice=10
